{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad-agent.local/schemas/spec.schema.json",
  "title": "Housing spec (CADCraft)",
  "description": "Source of truth for a floor plan. Units are meters. The DXF is generated from this file; never edit it by hand.",
  "type": "object",
  "required": ["unit", "clear_height", "walls", "rooms"],
  "additionalProperties": true,
  "properties": {
    "unit": {
      "type": "string",
      "const": "m",
      "description": "Spec unit. Always meters."
    },
    "project": {
      "type": "string",
      "description": "Project name (optional)."
    },
    "floor": {
      "type": "string",
      "description": "Floor name, for example 'GROUND FLOOR' (optional)."
    },
    "level": {
      "type": "string",
      "description": "Floor level, for example '+0.00' or '+2.90' (optional)."
    },
    "clear_height": {
      "type": "number",
      "minimum": 2.4,
      "description": "Minimum room clear height in meters."
    },
    "note": {
      "type": "string",
      "description": "Review or scope note (optional)."
    },
    "lot": {
      "type": "object",
      "description": "Lot data (optional; when present, validate_spec.py checks that rooms fit).",
      "required": ["front_m", "depth_m"],
      "properties": {
        "front_m": { "type": "number", "exclusiveMinimum": 0 },
        "depth_m": { "type": "number", "exclusiveMinimum": 0 },
        "area_m2": { "type": "number", "exclusiveMinimum": 0 },
        "party_walls": { "type": "boolean" },
        "corner": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "walls": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/wall" }
    },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/room" }
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "opening": {
      "type": "object",
      "required": ["type", "s", "width"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["door", "window", "opening"]
        },
        "use": {
          "type": "string",
          "description": "Door use: entrance, interior, bathroom, etc."
        },
        "s": {
          "type": "number",
          "minimum": 0,
          "description": "Distance from p1 to the opening center, in meters."
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Opening width in meters."
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Opening height in meters (optional)."
        },
        "sill": {
          "type": "number",
          "minimum": 0,
          "description": "Sill height in meters (optional)."
        }
      }
    },
    "wall": {
      "type": "object",
      "required": ["p1", "p2", "thickness", "openings"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["exterior", "interior"]
        },
        "thickness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Wall thickness in meters."
        },
        "p1": { "$ref": "#/$defs/point" },
        "p2": { "$ref": "#/$defs/point" },
        "openings": {
          "type": "array",
          "items": { "$ref": "#/$defs/opening" }
        }
      }
    },
    "room": {
      "type": "object",
      "required": ["name", "type", "x", "y", "w", "h"],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Room type; must exist in caba_rules.json (living, bedroom, bathroom, etc.)."
        },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
